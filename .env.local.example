# Bacara Club — environment variables
# Copy this file to .env.local and fill in real values. .env.local is gitignored.
# NEVER commit real secrets. Anything prefixed NEXT_PUBLIC_ is exposed to the browser.
#
# For production on Netlify, set these in Site settings → Environment variables.
# `NEXT_PUBLIC_*` vars are inlined at build time, so a redeploy is required after
# changing any of them.

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Used by metadataBase, canonical URLs, JSON-LD, and the sitemap.
NEXT_PUBLIC_SITE_URL=https://bacaraclub.com

# -----------------------------------------------------------------------------
# Supabase (used by /reserve + /guestlist server actions — Milestone 5)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: never expose to the browser. Used by admin/CRM routes.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Analytics — wired into src/app/layout.tsx via the components in
# src/components/analytics/. Missing values cause the components to render
# nothing (safe default for previews and local dev).
# -----------------------------------------------------------------------------

# Google Analytics 4 (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta (Facebook) Pixel ID (numeric, 15–16 digits)
NEXT_PUBLIC_META_PIXEL_ID=

# -----------------------------------------------------------------------------
# Site verification tokens — meta tags injected via metadata.verification in
# src/app/layout.tsx. Each one is optional; unset values are simply omitted.
# -----------------------------------------------------------------------------

# Google Search Console: "HTML tag" verification method. Paste only the token
# (content attribute), not the full <meta> tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Meta Business: domain verification token from Business Settings → Brand
# Safety → Domains.
NEXT_PUBLIC_FB_DOMAIN_VERIFICATION=

# -----------------------------------------------------------------------------
# Spline hero scene (added in Milestone 2, optional)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SPLINE_SCENE_URL=
