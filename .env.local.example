# Bacara Club — environment variables
# Copy this file to .env.local and fill in real values. .env.local is gitignored.
# NEVER commit real secrets. Anything prefixed NEXT_PUBLIC_ is exposed to the browser.

# Site
NEXT_PUBLIC_SITE_URL=https://bacaraclub.com

# Supabase (added in Milestone 5)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Analytics (added in Milestone 8)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Spline hero scene (added in Milestone 2)
NEXT_PUBLIC_SPLINE_SCENE_URL=
